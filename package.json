{
  "name": "maquinaria",
  "version": "1.1.0",
  "description": "Simple finite state machine implementation in javascript",
  "main": "dist/maquinaria.cjs.js",
  "module": "dist/maquinaria.esm.js",
  "unpkg": "dist/maquinaria.umd.js",
  "types": "maquinaria.d.ts",
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run --coverage",
    "pretest": "prettier --write -c maquinaria.js __test__/**.js && npm run build",
    "prepublishOnly": "npm t",
    "mutation": "stryker run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomas2387/maquinaria.git"
  },
  "files": [
    "dist/*",
    "maquinaria.d.ts"
  ],
  "keywords": [
    "finite",
    "state",
    "machine",
    "fsm",
    "state-machine",
    "typescript"
  ],
  "author": "tomas2387",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tomas2387/maquinaria/issues"
  },
  "homepage": "https://github.com/tomas2387/maquinaria#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.9.10",
    "rollup": "^4.68.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "minimatch": "^11.0.7",
    "qs": "^6.17.1"
  },
  "sideEffects": false
}
